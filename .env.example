# Optional — powers Agent Autopilot on /console (a real Groq LLM decides the
# agent's next move instead of a human clicking buttons). The site works
# fully without this; autopilot just stays off with a clear message.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=

# ── Lyzr AI agent (preferred over Groq for Autopilot when set) ─────────────
# The autonomous agent Finora governs, built on Lyzr Studio. Create an agent
# at https://studio.lyzr.ai, then paste its API key + agent id here.
LYZR_API_KEY=
LYZR_AGENT_ID=
# Optional overrides:
LYZR_API_URL=
LYZR_USER_ID=

# ── Supabase (off-chain data: accounts, telemetry, payment graph) ──────────
# Safe to expose client-side (protected by Row-Level Security).
# Without these, the app falls back to its deterministic simulation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose client-side, NEVER commit. Used by server routes
# that write telemetry/events.
SUPABASE_SERVICE_ROLE_KEY=

# ── On-chain (set after deploying to Base Sepolia) ────────────────────────
DEPLOYER_PRIVATE_KEY=                       # burner wallet ONLY
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=
NEXT_PUBLIC_CREDIT_LINE_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ESCROW_ADDRESS=
