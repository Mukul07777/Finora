# Optional — powers Agent Autopilot on /console (a real Groq LLM decides the
# agent's next move instead of a human clicking buttons). The site works
# fully without this; autopilot just stays off with a clear message.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=
