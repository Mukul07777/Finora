# Copy to .env and fill in. Never commit the real .env file.

# Private key of a BURNER wallet used only for testnet deployment.
# Generate a fresh wallet for this — never use a wallet holding real funds.
DEPLOYER_PRIVATE_KEY=

# Base Sepolia RPC endpoint (default public endpoint works, but is rate-limited).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: address to set as the agent's session key after deployment.
AGENT_ADDRESS=

# Optional: Basescan API key, for `npx hardhat verify`.
BASESCAN_API_KEY=
